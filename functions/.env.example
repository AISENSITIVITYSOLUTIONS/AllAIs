# Copie este archivo como functions/.env (no se sube a GitHub) y complete los valores.
# Límite diario por cuenta y límite por defecto de los códigos promocionales
DAILY_QUERY_LIMIT=20
PROMO_DEFAULT_DAILY_LIMIT=50
# Registro en Google Sheets (Apps Script publicado como aplicación web)
SHEETS_WEBHOOK_URL=
# SHEETS_WEBHOOK_TOKEN ya NO va aquí: se guarda como secreto de Firebase:
#   firebase functions:secrets:set SHEETS_WEBHOOK_TOKEN
# Protección contra abuso
RATE_SESSION_PER_15MIN=10
RATE_CHAT_PER_MIN=20
# Firebase App Check con reCAPTCHA v3 (clave de sitio pública). Deje vacío para desactivar.
APPCHECK_SITE_KEY=
# Cambie a true solo cuando haya comprobado que App Check funciona.
APPCHECK_ENFORCE=false
# Correos con acceso al panel /admin.html
ADMIN_EMAILS=fdealbam@nni.ai,fdealbam@gmail.com

# Mercado Pago (cobros). El token NO va aquí: se guarda como secreto de Firebase:
#   firebase functions:secrets:set MERCADOPAGO_ACCESS_TOKEN
# Montos mensuales en pesos (MXN). Déjelos vacíos hasta confirmar el precio; sin monto no se cobra.
MP_PRICE_LANZAMIENTO_MXN=
MP_PRICE_PROFESIONAL_1_MXN=
MP_PRICE_PROFESIONAL_2_MXN=
MP_PRICE_PROFESIONAL_3_MXN=
# Días de prueba gratuita antes del primer cobro.
BILLING_TRIAL_DAYS=3
# Solo sandbox: correo de un usuario de prueba de Mercado Pago (Cuentas de prueba) que hará el pago de prueba.
# Déjelo vacío en producción.
MP_PAYER_EMAIL=

# Modo de prueba interno: true activa la suscripción sin llamar a Mercado Pago. Dejar en false o vacío en producción.
BILLING_MOCK=false

# Uso gratuito: consultas de cortesía en total y tope diario al agotarlas.
FREE_COURTESY_TOTAL=12
FREE_DAILY_AFTER_COURTESY=2
# Lugares de Precio fundador (plan de $99).
FOUNDER_SEATS=100

# Correos de campaña a cuentas registradas (panel /admin.html). Sin estos valores no se envía nada.
# Con Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=correo@nni.ai y una
# contraseña de aplicación en SMTP_PASS (requiere verificación en dos pasos).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remitente visible. Si se deja vacío: AllAIs <SMTP_USER>
MAIL_FROM=
